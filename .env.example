# ============================================================
# BID — Plataforma Imobiliária — Variáveis de Ambiente
# ============================================================
# Copie este arquivo: cp .env.example .env.local
# NUNCA commite o .env.local com credenciais reais.
# ============================================================

# ---------------------------
# Supabase (obrigatório)
# ---------------------------
# URL do seu projeto Supabase (visível em: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-ID.supabase.co

# Chave pública (anon) — pode ser exposta no frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua-anon-key-aqui

# Chave service_role — NUNCA expor no frontend ou commitar
# Usada apenas em API Routes server-side
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua-service-role-key-aqui

# Hostname do Supabase para next/image (apenas o domínio, sem https://)
# Exemplo: abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_HOSTNAME=SEU-PROJECT-ID.supabase.co

# ---------------------------
# Admin — JWT (obrigatório)
# ---------------------------
# Segredo para assinar tokens JWT do painel admin
# Gere com: openssl rand -base64 64
ADMIN_JWT_SECRET=cole-aqui-uma-string-aleatoria-de-64-caracteres

# ---------------------------
# Admin — Setup inicial (uso único)
# ---------------------------
# Chave para criar o primeiro usuário admin via /admin/setup
# Gere com: openssl rand -base64 32
# IMPORTANTE: remova esta variável após criar o primeiro admin
ADMIN_SETUP_KEY=cole-aqui-uma-chave-segura-unica

# ---------------------------
# WhatsApp — Evolution API (opcional)
# ---------------------------
# URL da instância Evolution API para notificações WhatsApp ao corretor
EVOLUTION_API_URL=http://138.201.191.126:9500
# Chave da API
EVOLUTION_API_KEY=balcao-imobiliario-evolution-key-2024
# Nome da instância no Evolution Manager
EVOLUTION_INSTANCE=bid

# ---------------------------
# Cron (obrigatório para follow-ups automáticos)
# ---------------------------
# Autenticação do Vercel Cron para /api/cron/follow-ups
# Configure também em Vercel → Settings → Environment Variables
CRON_SECRET=cole-aqui-uma-chave-segura

# ---------------------------
# App (opcional)
# ---------------------------
# URL pública da aplicação (usada em redirecionamentos de email)
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br
